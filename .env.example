# Public site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform: database (Supabase Postgres via Prisma)
# Pooled connection (port 6543) for the app, direct/session connection (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=
# Set to 1 when running against the in-memory PGlite database (npm run db:local)
DATABASE_POOL_MAX=

# Platform: Supabase (Auth + Storage only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. The project's secret (service-role) key, from Supabase > Project settings > API.
# It bypasses all access rules, so never prefix it NEXT_PUBLIC_, never commit it, and set it only in
# the server environment (Vercel). Needed for files on CRM records.
SUPABASE_SERVICE_ROLE_KEY=

# Platform: email
RESEND_API_KEY=
MAIL_FROM="Cafton <no-reply@cafton.com>"

# Platform: scheduled jobs. Vercel sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=

# Platform: canonical site URL
SITE_URL=http://localhost:3000
