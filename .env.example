# Public site
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform: database (Supabase Postgres via Prisma)
# Pooled connection (port 6543) for the app, direct/session connection (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=
# Set to 1 when running against the in-memory PGlite database (npm run db:local)
DATABASE_POOL_MAX=

# Platform: Supabase (Auth + Storage only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Platform: email
RESEND_API_KEY=
MAIL_FROM="Cafton <no-reply@cafton.com>"

# Platform: canonical site URL
SITE_URL=http://localhost:3000
