// Source of truth for the platform's tables. Models are added phase by phase
// (see docs/ROADMAP.md). Things Prisma cannot express (exclusion constraints,
// check constraints, the auth.users trigger, RLS, append-only triggers) live in
// the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------ access (Phase 1)

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String   @unique
  description String?
  /// System roles take their permissions from code (lib/auth/permissions.ts).
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  profiles    Profile[]
  invites     StaffInvite[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Sign-up is invite-only: an auth user whose email is not here is rejected by a trigger.
model StaffInvite {
  email     String   @id
  roleId    String   @map("role_id") @db.Uuid
  invitedBy String?  @map("invited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("staff_invites")
}

/// One row per signed-in staff member. `id` equals auth.users.id (Supabase Auth).
model Profile {
  id            String   @id @db.Uuid
  email         String
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  roleId        String   @map("role_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Secret in the address of this person's calendar subscription link; null until they ask for one.
  calendarToken String?  @unique @map("calendar_token")
  /// Takes a turn at new website enquiries (round-robin). Off until someone is chosen under Users.
  takesLeads    Boolean  @default(false) @map("takes_leads")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("profiles")
}

/// Append-only (enforced by a trigger): who did what, to what, when.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for the development preview user and for system actions.
  actorId   String?  @map("actor_id") @db.Uuid
  /// Snapshot, so history still reads correctly after the person is removed.
  actorName String   @map("actor_name")
  /// Dotted verb, e.g. "user.invite", "role.update".
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ------------------------------------------------------------------ CRM (Phase 3)
// Money is stored as integer minor units (centavos) with an ISO currency code.
// Business records are soft-deleted (deleted_at); tasks and activities are not.

enum LeadStatus {
  new
  qualified
  disqualified
  converted

  @@map("lead_status")
}

enum StageKind {
  open
  won
  lost

  @@map("stage_kind")
}

enum ActivityType {
  note
  call
  email
  meeting
  stage_change
  system

  @@map("activity_type")
}

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  industry  String?
  size      String?
  website   String?
  phone     String?
  address   String?
  notes     String?
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  contacts Contact[]
  deals    Deal[]
  files    RecordFile[]
  /// Values of the custom fields set up under CRM > Custom fields, keyed by field key.
  custom   Json         @default("{}")
  /// Free-form labels, lower case, for filtering and grouping.
  tags     String[]     @default([])
  projects Project[]

  @@index([name])
  @@map("organizations")
}

model Contact {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String
  phone          String?
  position       String?
  organizationId String?   @map("organization_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  source         String    @default("manual")
  notes          String?
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deals        Deal[]
  leads        Lead[]
  activities   Activity[]
  tasks        Task[]
  meetings     Meeting[]
  files        RecordFile[]
  /// Values of the custom fields set up under CRM > Custom fields, keyed by field key.
  custom       Json          @default("{}")
  /// Free-form labels, lower case, for filtering and grouping.
  tags         String[]      @default([])
  projects     Project[]

  @@index([organizationId])
  @@index([lastName, firstName])
  @@map("contacts")
}

/// A website enquiry (the contact form). `answers` keeps the whole submission; the
/// promoted columns exist for lists and filters.
model Lead {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference          String     @unique @default(dbgenerated("(('LD-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('lead_reference_seq'::regclass))::text, 4, '0'::text)"))
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String
  phone              String?
  businessName       String?    @map("business_name")
  goalsArea          String?    @map("goals_area")
  budget             String?
  timeline           String?
  source             String     @default("website")
  pagePath           String?    @map("page_path")
  answers            Json
  status             LeadStatus @default(new)
  disqualifiedReason String?    @map("disqualified_reason")
  ownerId            String?    @map("owner_id") @db.Uuid
  contactId          String?    @map("contact_id") @db.Uuid
  convertedAt        DateTime?  @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal       Deal?
  activities Activity[]
  tasks      Task[]
  meetings   Meeting[]
  files      RecordFile[]
  /// Values of the custom fields set up under CRM > Custom fields, keyed by field key.
  custom     Json         @default("{}")
  /// Free-form labels, lower case, for filtering and grouping.
  tags       String[]     @default([])
  /// 0 to 100 from the contact form answers (features/crm/scoring.ts). Null until scored.
  score      Int?

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([score])
  @@map("leads")
}

/// Pipeline stages are data, not an enum, so the sales process can change without a migration.
/// A sales pipeline: its own ordered stages, with exactly one Won and one Lost.
model Pipeline {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String  @unique
  name      String
  position  Int     @default(0)
  isDefault Boolean @default(false) @map("is_default")

  stages PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  key            String    @unique
  name           String
  position       Int
  /// Chance of winning, 0 to 100. Drives the weighted forecast.
  probability    Int
  kind           StageKind @default(open)
  /// What must be true before a deal leaves this stage.
  exitCriteria   String?   @map("exit_criteria")
  /// Deal fields that must be filled in before a deal can move into this stage.
  requiredFields String[]  @default([]) @map("required_fields")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String    @unique @default(dbgenerated("(('DL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('deal_reference_seq'::regclass))::text, 4, '0'::text)"))
  title             String
  contactId         String    @map("contact_id") @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  stageId           String    @map("stage_id") @db.Uuid
  /// Integer minor units (centavos). Null until a value is known.
  amountMinor       BigInt?   @map("amount_minor")
  currency          String    @default("PHP")
  ownerId           String?   @map("owner_id") @db.Uuid
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  source            String    @default("manual")
  description       String?
  lostReason        String?   @map("lost_reason")
  leadId            String?   @unique @map("lead_id") @db.Uuid
  stageChangedAt    DateTime  @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  wonAt             DateTime? @map("won_at") @db.Timestamptz(6)
  lostAt            DateTime? @map("lost_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities   Activity[]
  tasks        Task[]
  meetings     Meeting[]
  /// Free-form labels, lower case, for filtering and grouping.
  tags         String[]      @default([])
  quotes       Quote[]
  contracts    Contract[]
  files        RecordFile[]
  /// Values of the custom fields set up under CRM > Custom fields, keyed by field key.
  custom       Json          @default("{}")
  projects     Project[]

  @@index([stageId])
  @@index([contactId])
  @@index([ownerId])
  @@map("deals")
}

/// The timeline. Attached to a lead, contact or deal (at least one).
model Activity {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ActivityType @default(note)
  body          String
  leadId        String?      @map("lead_id") @db.Uuid
  contactId     String?      @map("contact_id") @db.Uuid
  dealId        String?      @map("deal_id") @db.Uuid
  createdBy     String?      @map("created_by") @db.Uuid
  /// Snapshot, like the audit log.
  createdByName String       @map("created_by_name")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Pinned notes stay at the top of the timeline.
  pinned        Boolean      @default(false)
  editedAt      DateTime?    @map("edited_at") @db.Timestamptz(6)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt(sort: Desc)])
  @@index([contactId, createdAt(sort: Desc)])
  @@index([leadId, createdAt(sort: Desc)])
  @@map("activities")
}

model Task {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  dueAt      DateTime? @map("due_at") @db.Timestamptz(6)
  doneAt     DateTime? @map("done_at") @db.Timestamptz(6)
  assigneeId String?   @map("assignee_id") @db.Uuid
  leadId     String?   @map("lead_id") @db.Uuid
  contactId  String?   @map("contact_id") @db.Uuid
  dealId     String?   @map("deal_id") @db.Uuid
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([assigneeId, doneAt])
  @@index([dueAt])
  @@map("tasks")
}

// -------------------------------------------------------------------- CMS (Phase 2)
// The public website's content. Rich, optional parts (gallery, prizes, steps, links)
// are JSON validated by features/cms/schemas.ts; everything that is filtered, sorted
// or linked is a real column. `position` is the editor-controlled order for lists
// that are not sorted by date. Content is soft-deleted; only `published` rows are
// public. Slugs are unique among live rows (partial index in the migration).

enum PublishStatus {
  draft
  published

  @@map("publish_status")
}

enum AuthorKind {
  organization
  person

  @@map("author_kind")
}

model Author {
  /// Stable key referenced by content (e.g. "cafton"), not a generated id.
  id        String     @id
  kind      AuthorKind
  name      String
  role      String?
  /// Path or URL of the avatar image.
  avatar    String?
  /// Public profile page, if any.
  url       String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts    BlogPost[]
  projects PortfolioProject[]
  events   Event[]

  @@map("authors")
}

model BlogPost {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String
  authorId       String        @map("author_id")
  title          String
  excerpt        String
  /// Paragraphs, in order.
  content        String[]
  /// Photos/galleries placed after a paragraph (BlogMedia[]).
  media          Json?
  /// The date shown on the post.
  date           DateTime      @db.Date
  category       String
  imageLight     String?       @map("image_light")
  imageDark      String?       @map("image_dark")
  imageAlt       String?       @map("image_alt")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         PublishStatus @default(draft)
  position       Int           @default(0)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slug])
  @@index([status, date(sort: Desc)])
  @@map("blog_posts")
}

model PortfolioProject {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String
  authorId       String        @map("author_id")
  client         String
  title          String
  category       String
  /// Slugs of the service pillars this project belongs to.
  services       String[]
  summary        String
  description    String
  problem        String?
  solution       String?
  recognition    String?
  imageLight     String?       @map("image_light")
  imageDark      String?       @map("image_dark")
  imageAlt       String?       @map("image_alt")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  /// "cover" or "contain".
  imageFit       String?       @map("image_fit")
  /// More screenshots (BlogImage[]).
  media          Json?
  liveUrl        String?       @map("live_url")
  status         PublishStatus @default(draft)
  position       Int           @default(0)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slug])
  @@index([status, position])
  @@map("portfolio_projects")
}

model Event {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String
  authorId       String        @map("author_id")
  title          String
  type           String
  tagline        String
  summary        String
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  campaignUrl    String?       @map("campaign_url")
  startsAt       DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?     @map("ends_at") @db.Timestamptz(6)
  /// Force-close regardless of dates.
  closed         Boolean       @default(false)
  /// { src, alt, width, height }
  poster         Json?
  about          String[]
  prizesHeading  String?       @map("prizes_heading")
  /// EventPrize[]
  prizes         Json
  /// EventStep[]
  steps          Json?
  /// [label, value][]
  facts          Json?
  closedTitle    String?       @map("closed_title")
  closedNote     String?       @map("closed_note")
  /// EventPromo
  promo          Json?
  status         PublishStatus @default(draft)
  position       Int           @default(0)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slug])
  @@index([status, position])
  @@map("events")
}

model Partner {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String
  name        String
  shortName   String        @map("short_name")
  /// PartnerLogo { src, fit, plate? }
  logo        Json
  roles       String[]
  featured    Boolean       @default(false)
  description String?
  /// PartnerLink[]
  links       Json?
  status      PublishStatus @default(draft)
  position    Int           @default(0)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@index([slug])
  @@index([status, position])
  @@map("partners")
}

/// Questions shown on a service page, per service pillar.
model ServiceFaq {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceSlug String   @map("service_slug")
  question    String
  answer      String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([serviceSlug, position])
  @@map("service_faqs")
}

// ------------------------------------------------------------------- media (Phase 2)

/// An image in the media library. The bytes live in the Supabase Storage bucket `media`;
/// this row is what the dashboard lists, describes (alt text) and protects from deletion
/// while content still uses it.
model Media {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Path inside the bucket: content/<uuid>.<ext>
  path         String   @unique
  /// The original file name, for the library only.
  name         String
  /// Default alt text, offered when the image is picked. Each use can still say something different.
  alt          String   @default("")
  mime         String
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("media")
}

/// One editable document per area of the public site (settings, SEO, About text...). The
/// shape of `data` for each `key` is defined and validated in code (features/cms/site).
model SiteContent {
  key         String   @id
  data        Json
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_content")
}

enum MeetingStatus {
  requested
  confirmed
  completed
  cancelled
  no_show

  @@map("meeting_status")
}

enum MeetingMode {
  video
  phone
  in_person

  @@map("meeting_mode")
}

/// A scheduled conversation with someone outside Cafton. Linked to the lead, contact and deal it is about.
/// The database refuses two requested or confirmed meetings that overlap (hand-written constraint).
model Meeting {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  mode            MeetingMode   @default(video)
  /// A video link, a phone number or an address, depending on the mode.
  location        String?
  status          MeetingStatus @default(requested)
  /// "website" when the visitor asked for it on the contact form, "staff" otherwise.
  source          String        @default("staff")
  notes           String?
  cancelledReason String?       @map("cancelled_reason")
  attendeeName    String        @map("attendee_name")
  attendeeEmail   String        @map("attendee_email")
  attendeePhone   String?       @map("attendee_phone")
  leadId          String?       @map("lead_id") @db.Uuid
  contactId       String?       @map("contact_id") @db.Uuid
  dealId          String?       @map("deal_id") @db.Uuid
  ownerId         String?       @map("owner_id") @db.Uuid
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("meetings")
}

/// One row per reminder already sent, so the daily job never sends the same one twice.
model ReminderLog {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind   String
  refId  String   @map("ref_id")
  /// What the reminder was about (for a meeting, its start time), so a moved meeting is reminded again.
  forKey String   @map("for_key")
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@unique([kind, refId, forKey])
  @@map("reminder_logs")
}

/// A saved search/filter of a list, per person or shared with the team.
model SavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "leads", "contacts", "organizations", "deals" or "tasks".
  resource  String
  name      String
  /// The list's address query, e.g. "status=new&owner=me".
  query     String
  shared    Boolean  @default(false)
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resource, ownerId])
  @@map("saved_views")
}

/// In-app notifications for one staff member.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// What happened: "lead.new", "meeting.request", "task.assigned", "lead.assigned", "deal.assigned", "task.due".
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

enum PricingModel {
  fixed
  hourly
  retainer

  @@map("pricing_model")
}

enum QuoteStatus {
  draft
  pending_approval
  approved
  sent
  accepted
  declined
  expired
  superseded
  withdrawn

  @@map("quote_status")
}

/// What we sell: a service or product with a price and how it is charged.
model CatalogItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  pricingModel   PricingModel @default(fixed) @map("pricing_model")
  /// Integer minor units (centavos) per unit.
  unitPriceMinor BigInt       @map("unit_price_minor")
  /// What one unit is: "project", "hour", "month".
  unitLabel      String       @default("project") @map("unit_label")
  /// Whether VAT is added to it.
  taxable        Boolean      @default(true)
  active         Boolean      @default(true)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines QuoteLine[]

  @@index([active, name])
  @@map("catalog_items")
}

/// A priced offer for a deal. A revision is a new row with the next version number.
model Quote {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "QT-2026-0001". Every version of one quote shares it.
  reference          String
  version            Int         @default(1)
  dealId             String      @map("deal_id") @db.Uuid
  title              String
  intro              String?
  terms              String?
  currency           String      @default("PHP")
  status             QuoteStatus @default(draft)
  /// Percent VAT applied to taxable lines, frozen when the quote is made.
  taxRatePct         Int         @default(12) @map("tax_rate_pct")
  subtotalMinor      BigInt      @default(0) @map("subtotal_minor")
  taxMinor           BigInt      @default(0) @map("tax_minor")
  totalMinor         BigInt      @default(0) @map("total_minor")
  validUntil         DateTime?   @map("valid_until") @db.Date
  /// SHA-256 of the secret in the public link. The link itself is shown once (when sent or renewed)
  /// and never stored, so a database leak does not leak working links.
  tokenHash          String?     @unique @map("token_hash")
  /// Proof of exactly what was sent: a hash of the wording, lines, totals and validity at send time.
  sentHash           String?     @map("sent_hash")
  acceptedHash       String?     @map("accepted_hash")
  /// Share of the total due when the quote is accepted.
  depositPct         Int         @default(50) @map("deposit_pct")
  paymentTerms       String?     @map("payment_terms")
  withdrawnAt        DateTime?   @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnReason    String?     @map("withdrawn_reason")
  approvedBy         String?     @map("approved_by") @db.Uuid
  approvedAt         DateTime?   @map("approved_at") @db.Timestamptz(6)
  sentAt             DateTime?   @map("sent_at") @db.Timestamptz(6)
  sentTo             String?     @map("sent_to")
  viewedAt           DateTime?   @map("viewed_at") @db.Timestamptz(6)
  acceptedAt         DateTime?   @map("accepted_at") @db.Timestamptz(6)
  /// The e-acceptance record: who typed their name, from where, and what they agreed to.
  acceptedByName     String?     @map("accepted_by_name")
  acceptedByEmail    String?     @map("accepted_by_email")
  acceptedIp         String?     @map("accepted_ip")
  acceptedUserAgent  String?     @map("accepted_user_agent")
  acceptedTotalMinor BigInt?     @map("accepted_total_minor")
  declinedAt         DateTime?   @map("declined_at") @db.Timestamptz(6)
  declinedReason     String?     @map("declined_reason")
  createdBy          String?     @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal      Deal        @relation(fields: [dealId], references: [id], onDelete: Restrict)
  lines     QuoteLine[]
  contracts Contract[]
  project   Project?

  @@unique([reference, version])
  @@index([dealId])
  @@index([status])
  @@map("quotes")
}

model QuoteLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String  @map("quote_id") @db.Uuid
  position       Int
  catalogItemId  String? @map("catalog_item_id") @db.Uuid
  description    String
  /// Quantity in thousandths (1.5 hours = 1500), so no floating point.
  quantityMilli  Int     @map("quantity_milli")
  unitLabel      String  @default("unit") @map("unit_label")
  unitPriceMinor BigInt  @map("unit_price_minor")
  /// Discount in whole percent, 0 to 100.
  discountPct    Int     @default(0) @map("discount_pct")
  taxable        Boolean @default(true)
  /// Line total after discount, before tax.
  totalMinor     BigInt  @map("total_minor")

  quote Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
  @@map("quote_lines")
}

/// A person's sales goal for one month, in centavos.
model SalesTarget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  /// The first day of the month the target is for.
  month       DateTime @db.Date
  amountMinor BigInt   @map("amount_minor")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerId, month])
  @@index([month])
  @@map("sales_targets")
}

enum ContractKind {
  contract
  sow

  @@map("contract_kind")
}

enum ContractStatus {
  draft
  sent
  accepted
  declined
  withdrawn
  expired

  @@map("contract_status")
}

/// Reusable wording for contracts and statements of work. Merge fields are filled in per deal.
model ContractTemplate {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  kind      ContractKind @default(contract)
  body      String
  active    Boolean      @default(true)
  createdBy String?      @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  contracts Contract[]

  @@index([kind, active])
  @@map("contract_templates")
}

/// A contract or statement of work for a deal, accepted by the client through a secret link.
model Contract {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String         @unique
  dealId            String         @map("deal_id") @db.Uuid
  quoteId           String?        @map("quote_id") @db.Uuid
  templateId        String?        @map("template_id") @db.Uuid
  kind              ContractKind   @default(contract)
  title             String
  /// The full wording, merge fields already filled in. Editable only while a draft.
  body              String
  status            ContractStatus @default(draft)
  validUntil        DateTime?      @map("valid_until") @db.Date
  tokenHash         String?        @unique @map("token_hash")
  sentHash          String?        @map("sent_hash")
  acceptedHash      String?        @map("accepted_hash")
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(6)
  sentTo            String?        @map("sent_to")
  viewedAt          DateTime?      @map("viewed_at") @db.Timestamptz(6)
  acceptedAt        DateTime?      @map("accepted_at") @db.Timestamptz(6)
  acceptedByName    String?        @map("accepted_by_name")
  acceptedByEmail   String?        @map("accepted_by_email")
  acceptedIp        String?        @map("accepted_ip")
  acceptedUserAgent String?        @map("accepted_user_agent")
  declinedAt        DateTime?      @map("declined_at") @db.Timestamptz(6)
  declinedReason    String?        @map("declined_reason")
  withdrawnAt       DateTime?      @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnReason   String?        @map("withdrawn_reason")
  createdBy         String?        @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  deal     Deal              @relation(fields: [dealId], references: [id], onDelete: Restrict)
  quote    Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  template ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([status])
  @@map("contracts")
}

/// A file attached to a lead, contact, organization or deal (exactly one of them). The bytes live in
/// the private `crm-files` bucket under a random name; `name` is only what people see.
model RecordFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId         String?  @map("lead_id") @db.Uuid
  contactId      String?  @map("contact_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  /// "crm/<uuid>.<ext>"; never built from anything the uploader typed.
  path           String   @unique
  name           String
  mime           String
  sizeBytes      Int      @map("size_bytes")
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  /// Snapshot, so it still reads correctly after the person is removed.
  uploadedByName String   @map("uploaded_by_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@index([organizationId])
  @@index([dealId])
  @@map("record_files")
}

/// A field an administrator adds to one kind of record (lead, contact, organization or deal).
/// Values are stored on the record under `key`, which never changes.
model CustomField {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity    String
  key       String
  label     String
  type      String
  /// The choices of a "select" field.
  options   String[] @default([])
  /// Must be filled in whenever the record's custom fields are saved.
  required  Boolean  @default(false)
  position  Int      @default(0)
  /// Archived fields are hidden from forms but keep their values.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entity, key])
  @@index([entity, position])
  @@map("custom_fields")
}

/**
 * ------------------------------------------------------------------ delivery
 */

enum ProjectStatus {
  planned
  active
  on_hold
  completed
  cancelled

  @@map("project_status")
}

enum MilestoneStatus {
  pending
  in_progress
  done

  @@map("milestone_status")
}

enum ProjectTaskStatus {
  todo
  in_progress
  review
  done

  @@map("project_task_status")
}

enum ProjectTaskPriority {
  low
  normal
  high

  @@map("project_task_priority")
}

enum TimeEntryStatus {
  draft
  submitted
  approved
  rejected

  @@map("time_entry_status")
}

/// A piece of delivery work for a client. Usually started by an accepted quote (once per quote).
model Project {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String        @unique @default(dbgenerated("(('PRJ-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('project_reference_seq'::regclass))::text, 4, '0'::text)"))
  name              String
  description       String?
  dealId            String?       @map("deal_id") @db.Uuid
  quoteId           String?       @unique @map("quote_id") @db.Uuid
  contactId         String?       @map("contact_id") @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  status            ProjectStatus @default(planned)
  managerId         String?       @map("manager_id") @db.Uuid
  startDate         DateTime?     @map("start_date") @db.Date
  dueDate           DateTime?     @map("due_date") @db.Date
  /// The agreed price (integer minor units), when there is one.
  budgetMinor       BigInt?       @map("budget_minor")
  currency          String        @default("PHP")
  /// Hours the price assumes, in minutes.
  budgetMinutes     Int?          @map("budget_minutes")
  /// The slug of a portfolio entry that shows this project as a case study.
  portfolioSlug     String?       @map("portfolio_slug")
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  /// SHA-256 of the secret in the client's progress link; null while nothing is shared.
  progressTokenHash String?       @unique @map("progress_token_hash")
  progressSharedAt  DateTime?     @map("progress_shared_at") @db.Timestamptz(6)
  createdBy         String?       @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  deal         Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  quote        Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        ProjectTask[]
  timeEntries  TimeEntry[]

  @@index([status])
  @@index([dealId])
  @@index([managerId])
  @@map("projects")
}

model ProjectMember {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  /// What an hour of this person costs, in minor units: the basis of budget vs actual cost.
  costRateMinor BigInt?  @map("cost_rate_minor")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

model Milestone {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String
  description String?
  dueDate     DateTime?       @map("due_date") @db.Date
  status      MilestoneStatus @default(pending)
  position    Int             @default(0)
  /// Finishing a billable milestone is what Finance invoices (Phase 6).
  billable    Boolean         @default(false)
  amountMinor BigInt?         @map("amount_minor")
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId, position])
  @@map("milestones")
}

model ProjectTask {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String              @map("project_id") @db.Uuid
  milestoneId     String?             @map("milestone_id") @db.Uuid
  title           String
  description     String?
  status          ProjectTaskStatus   @default(todo)
  priority        ProjectTaskPriority @default(normal)
  assigneeId      String?             @map("assignee_id") @db.Uuid
  dueDate         DateTime?           @map("due_date") @db.Date
  estimateMinutes Int?                @map("estimate_minutes")
  /// Order within a board column, lowest first.
  position        Int                 @default(0)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  comments    TaskComment[]

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([milestoneId])
  @@map("project_tasks")
}

/// Hours someone worked, a day at a time. Submitted and approved a week at a time; approved time is frozen by a trigger.
model TimeEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  taskId      String?         @map("task_id") @db.Uuid
  profileId   String          @map("profile_id") @db.Uuid
  workDate    DateTime        @map("work_date") @db.Date
  /// The Monday of workDate's week (a check constraint keeps it so).
  weekStart   DateTime        @map("week_start") @db.Date
  minutes     Int
  note        String?
  billable    Boolean         @default(true)
  status      TimeEntryStatus @default(draft)
  submittedAt DateTime?       @map("submitted_at") @db.Timestamptz(6)
  reviewedBy  String?         @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewNote  String?         @map("review_note")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task    ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([profileId, weekStart])
  @@index([projectId, status])
  @@index([status, weekStart])
  @@map("time_entries")
}

model TaskComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  /// Snapshot, so the comment still reads correctly after the person is removed.
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// A reusable plan: milestones (with the share of the price each invoices) and tasks to start from.
model ProjectTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  /// TemplateMilestone[] (see features/delivery/rules.ts).
  milestones  Json     @default("[]")
  /// TemplateTask[].
  tasks       Json     @default("[]")
  active      Boolean  @default(true)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, name])
  @@map("project_templates")
}

/**
 * ------------------------------------------------------------------- finance
 */

enum AccountType {
  asset
  liability
  equity
  revenue
  expense

  @@map("account_type")
}

/// The chart of accounts. Accounts with a systemKey are the ones Finance posts to by role.
model Account {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique
  name        String
  type        AccountType
  description String?
  /// The role this account plays ("ar", "cash", "revenue_services"...): the code and name can change.
  systemKey   String?     @unique @map("system_key")
  active      Boolean     @default(true)
  createdBy   String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines JournalLine[]

  @@index([type, code])
  @@map("accounts")
}

/// One calendar month. A closed month takes no new postings (a database trigger enforces it).
model FiscalPeriod {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year     Int
  month    Int
  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime  @map("ends_on") @db.Date
  /// "open" or "closed".
  status   String    @default("open")
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy String?   @map("closed_by") @db.Uuid

  @@unique([year, month])
  @@index([startsOn, endsOn])
  @@map("fiscal_periods")
}

model TaxRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  /// Basis points: 1200 is 12.00%.
  rateBp    Int      @map("rate_bp")
  /// "vat", "percentage" or "withholding".
  kind      String   @default("vat")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tax_rates")
}

/// A balanced set of postings. Append-only (a trigger enforces it): a mistake is undone by a
/// reversing entry, never edited.
model JournalEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number        String   @unique @default(dbgenerated("(('JE-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('journal_entry_seq'::regclass))::text, 4, '0'::text)"))
  entryDate     DateTime @map("entry_date") @db.Date
  memo          String
  /// manual, invoice, credit_note, payment, bill, expense, bank, reversal, opening or tax.
  sourceKind    String   @default("manual") @map("source_kind")
  sourceId      String?  @map("source_id") @db.Uuid
  /// Set on an entry that undoes another; an entry can be undone once.
  reversesId    String?  @unique @map("reverses_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("Reversal")
  lines      JournalLine[]

  @@index([entryDate])
  @@index([sourceKind, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  position    Int     @default(0)
  /// Integer centavos. A line is a debit or a credit, never both and never neither.
  debitMinor  BigInt  @default(0) @map("debit_minor")
  creditMinor BigInt  @default(0) @map("credit_minor")
  memo        String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}
